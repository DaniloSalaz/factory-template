# Optional overrides for local development. mise.toml already provides working defaults;
# copy to .env (gitignored) only to change them. Values below are examples, not secrets.

# --- Required ---
# One of: development, staging, production
APP_ENV=development
# The API connects as app_runtime, which is subject to row-level security.
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/factory?sslmode=disable

# --- Migrations (not read by the API) ---
# Used only by `mise run migrate`. app_owner owns the tables; never give it to the API.
MIGRATIONS_DATABASE_URL=postgres://app_owner:app_owner@localhost:5432/factory?sslmode=disable

# --- HTTP (defaults shown) ---
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# 1 MiB
HTTP_MAX_HEADER_BYTES=1048576
# Request body limit, 1 MiB
HTTP_MAX_BODY_BYTES=1048576

# --- Browser ---
# Origin of the front end; return_to after login must resolve to it.
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated, exact origins for CORS and the CSRF Origin check. No wildcards.
ALLOWED_ORIGINS=http://localhost:5173
# Header carrying the client IP. Empty in development (RemoteAddr is used); defaults to
# CF-Connecting-IP in staging and production. X-Forwarded-For is refused.
TRUSTED_CLIENT_IP_HEADER=

# --- Sessions (defaults shown) ---
SESSION_IDLE_TTL=168h
SESSION_ABSOLUTE_TTL=720h

# --- WorkOS AuthKit ---
WORKOS_CLIENT_ID=client_XXXXXXXXXXXXXXXXXXXXXXXXXX
# Must be registered as a Redirect URI in the WorkOS dashboard.
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
# MFA is optional at WorkOS (not Required in the dashboard): the app verifies it itself,
# only for the roles of its catalog that require it (ADR 0002).
# The API key is a secret: it goes in secrets.env, encrypted with SOPS, never here.
# sops edit secrets.env   ->   WORKOS_API_KEY=sk_test_...

# --- Logging ---
# Level: debug, info (default), warn, error. Format: json (default), text
LOG_LEVEL=debug
LOG_FORMAT=json
