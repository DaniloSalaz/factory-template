# Every privilege app_runtime holds, granted to it or to PUBLIC
# (TestSchema_RuntimePrivilegesSnapshot). One privilege per line; # starts a comment.
#
# Changing this file is a security decision: the PR says which privilege changes and
# why the design needs it (AGENTS.md). Design, section 7.1.

app_runtime database CONNECT
app_runtime schema extensions USAGE
app_runtime schema public USAGE

app_runtime table public.audit_log SELECT

app_runtime table public.invitations DELETE
app_runtime table public.invitations INSERT
app_runtime table public.invitations SELECT
app_runtime column public.invitations.expires_at UPDATE
app_runtime column public.invitations.revoked_at UPDATE
app_runtime column public.invitations.token_hash UPDATE
app_runtime column public.invitations.updated_at UPDATE

app_runtime table public.memberships DELETE
app_runtime table public.memberships SELECT
app_runtime column public.memberships.role UPDATE
app_runtime column public.memberships.updated_at UPDATE

app_runtime table public.sessions DELETE
app_runtime table public.sessions INSERT
app_runtime table public.sessions SELECT
app_runtime column public.sessions.idle_expires_at UPDATE
app_runtime column public.sessions.last_seen_at UPDATE
app_runtime column public.sessions.mfa_auth_time UPDATE
app_runtime column public.sessions.revoked_at UPDATE
app_runtime column public.sessions.token_hash UPDATE
app_runtime column public.sessions.updated_at UPDATE

app_runtime table public.tenants SELECT
app_runtime column public.tenants.name UPDATE
app_runtime column public.tenants.updated_at UPDATE

app_runtime table public.user_identities INSERT
app_runtime table public.user_identities SELECT

app_runtime table public.users INSERT
app_runtime table public.users SELECT
app_runtime column public.users.email UPDATE
# Issue #4: the login updates email and email_verified together (design 5.1.7, 7.1).
app_runtime column public.users.email_verified UPDATE
app_runtime column public.users.last_login_at UPDATE
app_runtime column public.users.updated_at UPDATE

app_runtime function public.accept_invitation(p_token_hash bytea, p_ip_prefix cidr) EXECUTE
app_runtime function public.auth_membership(p_tenant_id uuid) EXECUTE
app_runtime function public.auth_memberships_for_user() EXECUTE
app_runtime function public.create_tenant_with_owner(p_name text, p_slug text, p_ip_prefix cidr) EXECUTE
app_runtime function public.record_audit(p_tenant_id uuid, p_action text, p_target_type text, p_target_id text, p_metadata jsonb, p_ip_prefix cidr) EXECUTE
app_runtime function public.roles_in_use() EXECUTE
app_runtime function public.tenant_status(p_tenant_id uuid) EXECUTE
