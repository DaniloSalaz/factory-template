        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(pgxpool_empty_acquire_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "adquisiciones que esperaron /s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum(rate(pgxpool_empty_acquire_wait_time_nanoseconds_total{job=~\"$service\"}[$__rate_interval])) / 1e9",
          "legendFormat": "segundos esperando /s"
        }
      ]
    },
